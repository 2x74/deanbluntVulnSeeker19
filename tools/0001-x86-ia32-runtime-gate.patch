 	return __ia32_enabled;
@@ -77,6 +88,9 @@ static __always_inline bool ia32_enabled(void)
 
 static inline void ia32_disable(void) {}
 
+#define ia32_exec_allowed()	(1)
+#define ia32_task_allowed()	(1)
+
 #endif
 
 static inline bool ia32_enabled_verbose(void)
