diff --git a/arch/x86/Kconfig b/arch/x86/Kconfig
index 8623c4a5c..02bfe8ca1 100644
--- a/arch/x86/Kconfig
+++ b/arch/x86/Kconfig
@@ -3131,6 +3131,19 @@ config IA32_EMULATION
 	  64-bit kernel. You should likely turn this on, unless you're
 	  100% sure that you don't have any 32-bit programs left.
 
+config IA32_RUNTIME_GATE
+	bool "Runtime gate for the 32-bit ABI"
+	depends on IA32_EMULATION
+	default y
+	help
+	  Keep the 32-bit entry points installed but closed. While the gate
+	  (sysctl abi.ia32_emulation, 0 = closed) is closed, ELF32 binaries
+	  cannot be exec'd, and 32-bit syscalls and modify_ldt() are only
+	  honoured for tasks that already have a 32-bit address space. This
+	  stops 64-bit processes from reaching the compat syscall surface
+	  (int $0x80, far jumps to the 32-bit code segment), and lets root open
+	  the gate only while a 32-bit program is needed.
+
 config IA32_EMULATION_DEFAULT_DISABLED
 	bool "IA32 emulation disabled by default"
 	default n
diff --git a/arch/x86/entry/syscall_32.c b/arch/x86/entry/syscall_32.c
index 2b15ea17b..4dcb7e0ab 100644
--- a/arch/x86/entry/syscall_32.c
+++ b/arch/x86/entry/syscall_32.c
@@ -8,6 +8,8 @@
 #include <linux/entry-common.h>
 #include <linux/nospec.h>
 #include <linux/uaccess.h>
+#include <linux/sysctl.h>
+#include <asm/ia32.h>
 #include <asm/apic.h>
 #include <asm/traps.h>
 #include <asm/cpufeature.h>
@@ -49,8 +51,35 @@ long ia32_sys_call(const struct pt_regs *regs, unsigned int nr)
 	}
 }
 
+#ifdef CONFIG_IA32_RUNTIME_GATE
+int ia32_runtime_gate __read_mostly;
+
+static const struct ctl_table ia32_gate_table[] = {
+	{
+		.procname	= "ia32_emulation",
+		.data		= &ia32_runtime_gate,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE,
+	},
+};
+
+static int __init ia32_gate_sysctl_init(void)
+{
+	register_sysctl("abi", ia32_gate_table);
+	return 0;
+}
+late_initcall(ia32_gate_sysctl_init);
+#endif
+
 static __always_inline int syscall_32_enter(struct pt_regs *regs)
 {
+	/* gate closed and not a real 32-bit task: no 32-bit ABI, report an invalid syscall */
+	if (IS_ENABLED(CONFIG_IA32_RUNTIME_GATE) && unlikely(!ia32_task_allowed()))
+		return -1;
+
 	if (IS_ENABLED(CONFIG_IA32_EMULATION))
 		current_thread_info()->status |= TS_COMPAT;
 
