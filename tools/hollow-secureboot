#!/bin/sh
# enroll hollow's own secure boot keys with sbctl and sign the boot files. DRY RUN unless --apply.
# usage: hollow-secureboot [--apply] [--keep-microsoft] FILE...     (FILE = signed-boot targets: kernel/UKI/grub efi)
set -e
APPLY=0; MS=""
while [ $# -gt 0 ]; do case $1 in
    --apply) APPLY=1; shift ;;
    --keep-microsoft) MS="--microsoft"; shift ;;
    *) break ;;
esac; done
[ -d /sys/firmware/efi ] || { echo "not a uefi boot, secure boot unavailable" >&2; exit 1; }
command -v sbctl >/dev/null || { echo "sbctl missing: xbps-install sbctl" >&2; exit 1; }
[ $# -gt 0 ] || { echo "give the files to sign (kernel, UKI, grub efi)" >&2; exit 2; }

sm=$(od -An -tu1 /sys/firmware/efi/efivars/SetupMode-8be4df61-93ca-11d2-aa0d-00e098032b8c | awk '{print $NF}')
if [ "$sm" != 1 ]; then
    echo "firmware is not in setup mode: clear the platform key in your uefi settings first (see hollow.rocks/docs/secure-boot)" >&2
    exit 1
fi

run() { echo "+ $*"; [ "$APPLY" = 1 ] && "$@" || true; }
run sbctl create-keys
run sbctl enroll-keys $MS
for f in "$@"; do run sbctl sign -s "$f"; done
run sbctl verify
[ "$APPLY" = 1 ] || echo "(dry run: nothing changed, re-run with --apply)"
